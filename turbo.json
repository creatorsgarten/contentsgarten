{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "public/build/**",
        ".netlify/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "dependsOn": ["^build"],
      "env": ["NETLIFY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
